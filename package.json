{
  "name": "universal-mcp-for-openrouter",
  "version": "1.2.0",
  "description": "Universal MCP server for OpenRouter API with config-driven tool management, budget controls, and cost-aware routing.",
  "main": "index.js",
  "bin": {
    "universal-mcp-for-openrouter": "./build/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "clean": "rm -rf build",
    "build": "npm run clean && tsc",
    "start": "node build/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "mcp",
    "openrouter",
    "ai",
    "agent",
    "llm",
    "antigravity",
    "claude-code",
    "opencode",
    "codex"
  ],
  "author": "Timothy Reid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tim/universal-mcp-for-openrouter.git"
  },
  "bugs": {
    "url": "https://github.com/tim/universal-mcp-for-openrouter/issues"
  },
  "homepage": "https://github.com/tim/universal-mcp-for-openrouter#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
